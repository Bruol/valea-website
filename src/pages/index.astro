    <!-- Video Section -->
    <section id="video" class="bg-[#111] py-16 md:py-24">
      <div class="mx-auto w-full max-w-[900px] px-6 md:px-8">
        <h2
          class="mb-8 text-[clamp(2.5rem,6vw,4rem)] font-extrabold leading-tight"
        >
          Teaser
        </h2>
        <div class="relative aspect-video overflow-hidden rounded">
          <iframe
            src="https://www.youtube-nocookie.com/embed/4iZVH2jsz0E?rel=0"
            title="ON THE MOON – Ideationsphase"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            loading="lazy"
            class="absolute inset-0 h-full w-full"></iframe>
        </div>
        <p class="mb-0 mt-4 text-sm opacity-60">
          © Michael Gärtner, Wetzikon TV
        </p>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="bg-zinc-950 py-16 md:py-24">
      <div class="mx-auto w-full max-w-[900px] px-6 md:px-8">
        <h2
          class="mb-8 text-[clamp(2.5rem,6vw,4rem)] font-extrabold leading-tight"
        >
          Kontakt
        </h2>
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-12">
          <div>
            <h3 class="mb-4 text-base uppercase tracking-[0.015em] opacity-40">
              Produktionsleitung
            </h3>
            <p class="mb-2">Valea Völcker</p>
            <p class="mb-2">
              <a
                class="border-b border-white/30 text-zinc-200 transition hover:border-white hover:text-white hover:no-underline"
                href="mailto:info@valeavolcker.com">info@valeavolcker.com</a
              >
            </p>
